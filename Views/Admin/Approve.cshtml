@model OnlineBankingApplication.ViewModels.ApproveCustomerVM

@{
    ViewData["Title"] = "Approve Customer";
}

<h2 class="mb-4 text-primary">Approve Customer</h2>

<div class="card shadow">
    <div class="card-header bg-success text-white">
        Approve Customer Account
    </div>

    <div class="card-body">

        <form asp-action="Approve" method="post">

            <input asp-for="CustomerId" type="hidden" />

            <div class="mb-3">
                <label class="form-label">Customer Name</label>
                <input asp-for="CustomerName" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="InitialDeposit" class="form-label">
                    Initial Deposit
                </label>

                <input asp-for="InitialDeposit"
                       class="form-control"
                       placeholder="Enter initial deposit" />

                <span asp-validation-for="InitialDeposit"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">
                Approve & Create Account
            </button>

            <a asp-action="Dashboard" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
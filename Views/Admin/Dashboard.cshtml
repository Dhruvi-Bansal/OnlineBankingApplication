@model IEnumerable<OnlineBankingApplication.Models.Customer>

<h2 class="mb-4">
    Pending Customer Approvals
</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Mobile</th>
            <th>Account Type</th>
            <th>Branch</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FirstName @item.LastName</td>
                    <td>@item.Email</td>
                    <td>@(item.Phone ?? "N/A")</td>
                    <td>@item.AccountType</td>
                    <td>@item.Branch</td>
                    <td>@item.Status</td>

                    <td>
                        <a asp-action="Approve"
                           asp-route-id="@item.CustomerId"
                           class="btn btn-success btn-sm">
                            Approve
                        </a>

                        <a asp-action="Reject"
                           asp-route-id="@item.CustomerId"
                           class="btn btn-danger btn-sm">
                            Reject
                        </a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">
                    No Pending Customers
                </td>
            </tr>
        }
        <li class="nav-item">
            <a class="nav-link"
               asp-controller="Admin"
               asp-action="ChequeBookRequests">
                Cheque Book Requests
            </a>
        </li>

    </tbody>

</table>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Secure Online Banking</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnlineBankingApplication.styles.css" asp-append-version="true" />
</head>

<body>

    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">

            <div class="container-fluid">

                <!-- Brand -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Bank"
                   asp-action="Index">

                    🏦 Secure Bank

                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <!-- Left Menu -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Bank"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Customer"
                                       asp-action="Dashboard">

                                        Dashboard

                                    </a>

                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">

                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Dashboard">

                                        Admin Panel

                                    </a>

                                </li>
                            }
                        }

                    </ul>

                    <!-- Right Menu -->
                    <ul class="navbar-nav ms-auto">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">

                                <span class="nav-link text-white fw-semibold">

                                    Hello, @User.Identity.Name

                                </span>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link text-warning fw-semibold"
                                   asp-controller="Account"
                                   asp-action="Logout">

                                    Logout

                                </a>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a class="nav-link text-white"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="btn btn-light btn-sm ms-2"
                                   asp-controller="Account"
                                   asp-action="Register">

                                    Register

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <!-- Main Content -->
    <div class="container mt-4">

        <main role="main" class="pb-4">

            @RenderBody()

        </main>

    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted mt-5 py-3 bg-light">

        <div class="container text-center">

            &copy; 2026 - Secure Online Banking System |
            <a asp-controller="Home" asp-action="Privacy">

                Privacy Policy

            </a>

        </div>

    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Secure Online Banking</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnlineBankingApplication.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

        <div class="container-fluid">

            <a class="navbar-brand fw-bold"
               asp-controller="Bank"
               asp-action="Index">

                <i class="bi bi-bank2"></i>
                Secure Bank

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbar">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navbar">

                <!-- LEFT MENU -->

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Bank"
                           asp-action="Index">

                            <i class="bi bi-house-door"></i>
                            Home

                        </a>

                    </li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Customer"
                                   asp-action="Dashboard">

                                    <i class="bi bi-speedometer2"></i>
                                    Dashboard

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="ChequeBook"
                                   asp-action="Status">

                                    <i class="bi bi-journal-bookmark-fill"></i>
                                    Cheque Book Status

                                </a>

                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Dashboard">

                                    <i class="bi bi-people-fill"></i>
                                    Customer Requests

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="ChequeBookRequests">

                                    <i class="bi bi-journal-check"></i>
                                    Cheque Book Requests

                                </a>

                            </li>
                        }
                    }

                </ul>

                <!-- RIGHT MENU -->

                <ul class="navbar-nav ms-auto">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">

                            <span class="nav-link text-white">

                                <i class="bi bi-person-circle"></i>

                                Hello,
                                <strong>@User.Identity.Name</strong>

                            </span>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link text-warning fw-bold"
                               asp-controller="Account"
                               asp-action="Logout">

                                <i class="bi bi-box-arrow-right"></i>

                                Logout

                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">

                                Login

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="btn btn-light ms-2"
                               asp-controller="Account"
                               asp-action="Register">

                                Register

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

    <!-- ================= BODY ================= -->

    <div class="container mt-4">

        @RenderBody()

    </div>

    <!-- ================= FOOTER ================= -->

    <footer class="border-top mt-5 bg-light">

        <div class="container py-3 text-center">

            © 2026 Secure Online Banking System |
            <a asp-controller="Home"
               asp-action="Privacy">

                Privacy Policy

            </a>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
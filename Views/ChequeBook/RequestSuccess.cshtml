@{
    ViewData["Title"] = "Cheque Book Request";
}

<div class="container mt-5" style="height:65vh">

    <div class="card shadow-lg">

        <div class="card-header bg-success text-white text-center">

            <h2>Cheque Book Request Received</h2>

        </div>

        <div class="card-body text-center p-5">

            <div class="mb-4">

                <i class="bi bi-check-circle-fill text-success"
                   style="font-size:80px;"></i>

            </div>

            <h3 class="text-success">
                Thank You!
            </h3>

            <p class="lead mt-3">

                <strong>Your cheque book request has been received successfully.</strong>

            </p>

            <div class="alert alert-warning mt-4">

                <h5>What happens next?</h5>

                <hr />

                ✔ Your request will be reviewed by the <strong>Bank Administrator</strong>.<br /><br />

                ✔ After approval, your cheque book will be printed.<br /><br />

                ✔ It will be delivered to your registered address within
                <strong>5–7 working days.</strong>

            </div>

            <a asp-controller="Customer"
               asp-action="Dashboard"
               class="btn btn-primary btn-lg">

                Back to Dashboard

            </a>

        </div>

    </div>

</div>
@model IEnumerable<OnlineBankingApplication.Models.ChequeBookRequest>

@{
    ViewData["Title"] = "Cheque Book Status";
}

<div class="container mt-5" style="height:65vh">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h3>Cheque Book Request History</h3>
        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    You have not requested a cheque book yet.
                </div>

                <a asp-action="Request" class="btn btn-success">
                    Request Cheque Book
                </a>
            }
            else
            {
                <table class="table table-bordered table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>Request Date</th>
                            <th>Status</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @(item.RequestDate?.ToString("dd MMM yyyy"))
                                </td>

                                <td>

                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (item.Status == "Approved")
                                    {
                                        <span class="text-success">
                                            Your cheque book will be delivered within
                                            <strong>5-7 working days.</strong>
                                        </span>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="text-warning">
                                            Waiting for administrator approval.
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger">
                                            Request rejected by administrator.
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

                <div class="mt-3">

                    <a asp-action="Request"
                       class="btn btn-primary">

                        Request New Cheque Book

                    </a>

                </div>
            }

        </div>

    </div>

</div>
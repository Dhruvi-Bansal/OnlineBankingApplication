@model OnlineBankingApplication.Models.Beneficiary

@{
    ViewData["Title"] = "Add Beneficiary";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h3>Add Beneficiary</h3>

        </div>

        <div class="card-body">

            <form asp-action="Add">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">

                    <label asp-for="BeneficiaryName"></label>

                    <input asp-for="BeneficiaryName" class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="NickName"></label>

                    <input asp-for="NickName" class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="AccountNumber"></label>

                    <input asp-for="AccountNumber"
                           class="form-control"
                           maxlength="18" />

                </div>

                <div class="mb-3">

                    <label asp-for="Ifsccode"></label>

                    <input asp-for="Ifsccode"
                           class="form-control"
                           placeholder="SBIN0001234" />

                </div>

                <button class="btn btn-primary">

                    Save Beneficiary

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Back

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
@model OnlineBankingApplication.Models.Beneficiary

@{
    ViewData["Title"] = "Delete Beneficiary";
}

<div class="container mt-5" style="height:65vh">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">

            <h3>Delete Beneficiary</h3>

        </div>

        <div class="card-body">

            <h5>

                Are you sure you want to remove this beneficiary?

            </h5>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">

                    Name

                </dt>

                <dd class="col-sm-9">

                    @Model.BeneficiaryName

                </dd>

                <dt class="col-sm-3">

                    Nickname

                </dt>

                <dd class="col-sm-9">

                    @Model.NickName

                </dd>

                <dt class="col-sm-3">

                    Account Number

                </dt>

                <dd class="col-sm-9">

                    @(new string('X', Model.AccountNumber.Length - 4)
                    + Model.AccountNumber.Substring(Model.AccountNumber.Length - 4))

                </dd>

                <dt class="col-sm-3">

                  IFSC

                </dt>

                <dd class="col-sm-9">

                    @Model.Ifsccode

                </dd>

            </dl>

            <form asp-action="Delete">

                <input asp-for="BeneficiaryId" type="hidden" />

                <button class="btn btn-danger">

                    Delete Beneficiary

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>
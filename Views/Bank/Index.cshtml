@{
    ViewData["Title"] = "Online Banking";
}

<div class="container-fluid p-0 bg-light">

    <!-- Hero Section -->
    <div class="py-5 text-center text-white"
         style="background:linear-gradient(135deg,#1E3A8A,#0F766E);">

        <div class="container">

            <h1 class="display-3 fw-bold mb-3">
                Secure Online Banking
            </h1>

            <p class="lead mb-4">
                Safe • Fast • Trusted Banking Services
            </p>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-outline-light btn-lg px-4 fw-semibold" style="background-color:blanchedalmond; color:black">

                Customer Login

            </a>

            <a asp-controller="Admin"
               asp-action="Login"
               class="btn btn-outline-light btn-lg px-4 fw-semibold" style="background-color:blanchedalmond; color:black">

                Admin Login

            </a>

        </div>

    </div>

    <!-- Helpline -->

    <div class="container mt-4">

        <div class="alert border-0 shadow-sm text-center"
             style="background:#E0F2FE;color:#0F172A;">

            <strong>📞 Customer Care:</strong>
            1800-123-4567

            <span class="mx-4">|</span>

            <strong>Email:</strong>
            support@onlinebank.com

        </div>

    </div>

    <!-- Services -->

    <div class="container py-5">

        <h2 class="text-center fw-bold mb-5 text-dark">
            Our Banking Services
        </h2>

        <div class="row g-4">

            <div class="col-lg-3 col-md-6">

                <div class="card border-0 shadow-sm text-center h-100">

                    <div class="card-body py-5">

                        <div class="display-5 mb-3">
                            💰
                        </div>

                        <h5 class="fw-bold">
                            Money Transfer
                        </h5>

                        <p class="text-muted mb-0">
                            Instant & secure transfers.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card border-0 shadow-sm text-center h-100">

                    <div class="card-body py-5">

                        <div class="display-5 mb-3">
                            🏦
                        </div>

                        <h5 class="fw-bold">
                            Open Account
                        </h5>

                        <p class="text-muted mb-0">
                            Open your account online.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card border-0 shadow-sm text-center h-100">

                    <div class="card-body py-5">

                        <div class="display-5 mb-3">
                            💳
                        </div>

                        <h5 class="fw-bold">
                            Bill Payment
                        </h5>

                        <p class="text-muted mb-0">
                            Pay utilities anytime.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card border-0 shadow-sm text-center h-100">

                    <div class="card-body py-5">

                        <div class="display-5 mb-3">
                            📒
                        </div>

                        <h5 class="fw-bold">
                            Cheque Book
                        </h5>

                        <p class="text-muted mb-0">
                            Request online in minutes.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- About -->

    <div class="container pb-5">

        <div class="card border-0 shadow-lg">

            <div class="card-body p-5">

                <h3 class="fw-bold mb-3 text-primary">

                    About Our Bank

                </h3>

                <p class="text-secondary fs-5 mb-0">

                    Our Online Banking System offers secure banking services
                    including fund transfers, bill payments, account management,
                    fixed deposits, cheque book requests, and modern digital
                    banking solutions designed for convenience and security.

                </p>

            </div>

        </div>

    </div>

</div>
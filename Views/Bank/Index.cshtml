@{
    ViewData["Title"] = "Online Banking";
}
<style>
    .buttons-login{
        width:70px;
        height:50px;
        
    }
</style>
<div class="container-fluid p-0 bg-light">

    <div class="py-5 text-center text-white"
         style="background:linear-gradient(135deg,#1E3A8A,#0F766E);">

        <div class="container">

            <h1 class="display-3 fw-bold mb-3">
                Secure Online Banking System
            </h1>

            <p class="lead mb-4">
                Secure • Fast • Reliable Banking at Your Fingertips
            </p>

            @if (!User.Identity.IsAuthenticated)
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-light btn-lg"
                   style="width:170px;background-color:aliceblue; color:#1E3A8A;font-weight:450">

                    Customer Login

                </a>

                

                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn-light btn-lg"
                   style="width:170px;background-color:aliceblue; color:#1E3A8A;font-weight:480">

                    Register

                </a>
            }
            else
            {
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin"
                       asp-action="Dashboard"
                       class="btn btn-warning btn-lg"
                       style="background-color:#f7f9fa; color:#1E3A8A">

                        Go to Admin Dashboard

                    </a>
                }
                else
                {
                    <a asp-controller="Customer"
                       asp-action="Dashboard"
                       class="btn btn-warning btn-lg"
                       style="background-color:#dfeaf2; color:#1E3A8A">

                        Go to Customer Dashboard

                    </a>
                }
            }

        </div>

    </div>

    <!-- Contact -->

    <div class="container mt-4">

        <div class="alert alert-info text-center shadow-sm">

            <strong>Customer Care:</strong> 1800-123-4567

            &nbsp;&nbsp;|

            <strong>Email:</strong> support@onlinebank.com

        </div>

    </div>

    <!-- Banking Services -->

    <div class="container py-5">

        <h2 class="text-center fw-bold mb-5" style="color:#1E3A8A">

            Our Services

        </h2>

        <div class="row g-4">

            <div class="col-md-3">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <h1>🏦</h1>

                        <h5 style="color:#1E3A8A">Open Bank Account</h5>

                        <p style="color:#1E3A8A">
                            Open your savings or current account completely online.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <h1>💸</h1>

                        <h5 style="color:#1E3A8A">Fund Transfer</h5>

                        <p style="color:#1E3A8A">
                            Transfer money securely between bank accounts.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <h1>💳</h1>

                        <h5 style="color:#1E3A8A">Bill Payments</h5>

                        <p style="color:#1E3A8A">
                            Pay electricity, gas, water and mobile bills.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <h1>📒</h1>

                        <h5 style="color:#1E3A8A">Cheque Book</h5>

                        <p style="color:#1E3A8A">
                            Request a new cheque book online anytime.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Features -->

    <div class="container py-5">
        <h2 class="text-center fw-bold mb-5" style="color:#1E3A8A">

            Our Features

        </h2>
        <div class="row g-3">

            <div class="col-md-4">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <h5 style="color:#1E3A8A">Secure Banking</h5>

                        <p style="color:#1E3A8A">
                            Password hashing, Identity authentication and role-based authorization.
                        </p>
                    </div>

                </div>
            </div>

            <div class="col-md-4">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <h5 style="color:#1E3A8A">Fast Transactions</h5>

                        <p style ="color:#1E3A8A">
                            Real-time balance updates and secure fund transfers.
                        </p>
                    </div>
                </div>

            </div>

            <div class="col-md-4">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <h5 style="color:#1E3A8A">24×7 Banking</h5>

                        <p style="color:#1E3A8A">
                            Access your account from anywhere at any time.
                        </p>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>
@{
    ViewData["Title"] = "Online Banking";
}

<div class="container-fluid p-0 bg-light">

    <!-- Hero Section -->
    <div class="py-5 text-center text-white"
         style="background:linear-gradient(135deg,#1E3A8A,#0F766E);">

        <div class="container">

            <h1 class="display-3 fw-bold mb-3">
                Secure Online Banking System
            </h1>

            <p class="lead mb-4">
                Secure • Fast • Reliable Banking at Your Fingertips
            </p>

            @if (!User.Identity.IsAuthenticated)
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-light btn-lg">

                    Customer Login

                </a>

                <a asp-controller="Account"
                   asp-action="AdminLogin"
                   class="btn btn-dark btn-lg">
                    Admin Login
                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn btn-warning btn-lg">

                    Register

                </a>
            }
            else
            {
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin"
                       asp-action="Dashboard"
                       class="btn btn-warning btn-lg">

                        Go to Admin Dashboard

                    </a>
                }
                else
                {
                    <a asp-controller="Customer"
                       asp-action="Dashboard"
                       class="btn btn-warning btn-lg">

                        Go to Customer Dashboard

                    </a>
                }
            }

        </div>

    </div>

    <!-- Contact -->

    <div class="container mt-4">

        <div class="alert alert-info text-center shadow-sm">

            <strong>Customer Care:</strong> 1800-123-4567

            &nbsp;&nbsp;|

            <strong>Email:</strong> support@onlinebank.com

        </div>

    </div>

    <!-- Banking Services -->

    <div class="container py-5">

        <h2 class="text-center fw-bold mb-5">

            Our Services

        </h2>

        <div class="row g-4">

            <div class="col-md-3">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <h1>🏦</h1>

                        <h5>Open Bank Account</h5>

                        <p>
                            Open your savings or current account completely online.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <h1>💸</h1>

                        <h5>Fund Transfer</h5>

                        <p>
                            Transfer money securely between bank accounts.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <h1>💳</h1>

                        <h5>Bill Payments</h5>

                        <p>
                            Pay electricity, gas, water and mobile bills.
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-md-3">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <h1>📒</h1>

                        <h5>Cheque Book</h5>

                        <p>
                            Request a new cheque book online anytime.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Features -->

    <div class="container py-5">

        <div class="row text-center">

            <div class="col-md-4">

                <h3>🔒</h3>

                <h5>Secure Banking</h5>

                <p>
                    Password hashing, Identity authentication and role-based authorization.
                </p>

            </div>

            <div class="col-md-4">

                <h3>⚡</h3>

                <h5>Fast Transactions</h5>

                <p>
                    Real-time balance updates and secure fund transfers.
                </p>

            </div>

            <div class="col-md-4">

                <h3>📈</h3>

                <h5>24×7 Banking</h5>

                <p>
                    Access your account from anywhere at any time.
                </p>

            </div>

        </div>

    </div>

</div>
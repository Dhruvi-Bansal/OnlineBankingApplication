@model IEnumerable<OnlineBankingApplication.Models.Transaction>

@{
    ViewData["Title"] = "Transaction History";
}

<div class="container mt-4" style="height:65vh">

    <div class="card shadow">

        <div class="card-header bg-success text-white">

            <h3>

                Transaction History

            </h3>

        </div>

        <div class="card-body">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">

                    <tr>

                        <th>Date</th>

                        <th>Reference</th>

                        <th>Type</th>

                        <th>Amount</th>

                        <th>Status</th>

                        <th></th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                @item.TransactionDate

                            </td>

                            <td>

                                @item.TransactionReference

                            </td>

                            <td> 
                                @if (item.SenderAccountId == (int?)ViewBag.CurrentAccountId) {
                                    <span class="badge bg-danger">Debit</span>
                                } 
                                else
                                {

                                    <span class="badge bg-success">Credit</span>
                                }
                            </td>

                            <td> 
                                @if (item.SenderAccountId == (int?)ViewBag.CurrentAccountId) 
                                {
                                    <span class="text-danger fw-bold"> -₹ @item.Amount.ToString("N2") </span>
                                } 
                                else
                                {

                                    <span class="text-success fw-bold"> +₹ @item.Amount.ToString("N2") </span>
                                }
                            </td>

                            <td>

                                @item.Status

                            </td>

                            <td>

                                <a asp-action="Receipt"
                                   asp-route-id="@item.TransactionId"
                                   class="btn btn-primary btn-sm">

                                    Receipt

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
@model OnlineBankingApplication.ViewModels.TransferMoneyVM

@{
    ViewData["Title"] = "Fund Transfer";
}


<div class="container mt-4">

    <div class="card shadow">


        <div class="card-header bg-primary text-white">

            <h3 class="mb-0">
                Fund Transfer
            </h3>

        </div>


        <div class="card-body">


            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }


            <form asp-action="Transfer" method="post">


                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>



                <div class="mb-3">

                    <label asp-for="ReceiverAccountNumber"
                           class="form-label">
                        Receiver Account Number
                    </label>


                    <input asp-for="ReceiverAccountNumber"
                           class="form-control"
                           placeholder="Enter receiver account number" />


                    <span asp-validation-for="ReceiverAccountNumber"
                          class="text-danger">
                    </span>

                </div>




                <div class="mb-3">

                    <label asp-for="Amount"
                           class="form-label">
                    </label>


                    <input asp-for="Amount"
                           class="form-control" />


                    <span asp-validation-for="Amount"
                          class="text-danger">
                    </span>

                </div>




                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>


                    <textarea asp-for="Description"
                              rows="3"
                              class="form-control">
                    </textarea>

                </div>




                <button class="btn btn-success btn-lg">

                    Transfer Money

                </button>


                <a asp-action="History"
                   class="btn btn-secondary btn-lg">

                    View History

                </a>


            </form>


        </div>

    </div>

</div>



@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
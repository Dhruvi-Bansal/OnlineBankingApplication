@model OnlineBankingApplication.Models.BillPayment

@{
    ViewData["Title"] = "Payment Receipt";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">

            <h3>Utility Bill Payment Receipt</h3>

        </div>

        <div class="card-body">

            <table class="table table-bordered">

                <tr>
                    <th>Transaction Reference</th>
                    <td>@Model.Transaction.TransactionReference</td>
                </tr>

                <tr>
                    <th>Payment Date</th>
                    <td>@Model.PaymentDate</td>
                </tr>

                <tr>
                    <th>Account Number</th>
                    <td>@Model.Account.AccountNumber</td>
                </tr>

                <tr>
                    <th>Customer Name</th>
                    <td>
                        @Model.Account.Customer.FirstName
                        @Model.Account.Customer.LastName
                    </td>
                </tr>

                <tr>
                    <th>Bill Type</th>
                    <td>@Model.Bill.BillType</td>
                </tr>

                <tr>
                    <th>Provider</th>
                    <td>@Model.Bill.ProviderName</td>
                </tr>

                <tr>
                    <th>Customer Number</th>
                    <td>@Model.Bill.CustomerNumber</td>
                </tr>

                <tr>
                    <th>Amount Paid</th>
                    <td>₹@Model.Amount</td>
                </tr>

                <tr>
                    <th>Status</th>
                    <td>

                        <span class="badge bg-success">

                            @Model.Status

                        </span>

                    </td>

                </tr>

            </table>

            <a asp-action="History"
               class="btn btn-primary">

                Back to History

            </a>

            <button onclick="window.print()"
                    class="btn btn-success">

                Print Receipt

            </button>

        </div>

    </div>

</div>
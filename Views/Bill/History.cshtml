@model IEnumerable<OnlineBankingApplication.Models.BillPayment>

@{
    ViewData["Title"] = "Bill Payment History";
}

<div class="container mt-4" style="height:65vh">

    <div class="card shadow">

        <div class="card-header bg-dark text-white">

            <h3>Bill Payment History</h3>

        </div>

        <div class="card-body">

            <table class="table table-bordered table-striped">

                <thead>

                    <tr>

                        <th>Date</th>

                        <th>Bill Type</th>

                        <th>Provider</th>

                        <th>Customer No.</th>

                        <th>Amount</th>

                        <th>Status</th>

                        <th>Receipt</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.PaymentDate?.ToString("dd-MMM-yyyy hh:mm tt")
                            </td>

                            <td>
                                @item.Bill.BillType
                            </td>

                            <td>
                                @item.Bill.ProviderName
                            </td>

                            <td>
                                @item.Bill.CustomerNumber
                            </td>

                            <td>
                                ₹@item.Amount
                            </td>

                            <td>

                                <span class="badge bg-success">
                                    @item.Status
                                </span>

                            </td>

                            <td>

                                <a asp-action="Receipt"
                                   asp-route-id="@item.TransactionId"
                                   class="btn btn-primary btn-sm">

                                    View

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
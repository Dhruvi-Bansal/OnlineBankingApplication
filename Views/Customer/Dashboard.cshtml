@model OnlineBankingApplication.ViewModels.CustomerDashboardVM

@{
    ViewData["Title"] = "Customer Dashboard";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body {
        background: #F4F8FC;
        font-family: 'Segoe UI', Tahoma, sans-serif;
    }

    /* Welcome Banner */
    .welcome-card {
        background: linear-gradient(135deg, #0B4F8C, #1D7CD8);
        color: white;
        border-radius: 20px;
        padding: 35px;
        margin-bottom: 30px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, .15);
    }

        .welcome-card h2 {
            font-weight: 700;
        }

        .welcome-card p {
            opacity: .9;
        }

    /* Cards */
    .dashboard-card {
        background: white;
        border: none;
        border-radius: 18px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, .08);
        transition: .3s;
        overflow: hidden; 
    }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, .12);
        }

    .icon {
        font-size: 42px;
        color: #0B4F8C;
    }

    .balance {
        color: #0B4F8C;
        font-size: 34px;
        font-weight: bold;
    }

    /* Quick Buttons */
    .quick-btn {
        display: block;
        width: 100%;
        padding: 16px;
        border-radius: 12px;
        text-align: center;
        text-decoration: none;
        background: #0B4F8C;
        color: white;
        font-weight: 600;
        transition: .3s;
    }

        .quick-btn:hover {
            background: #1565C0;
            color: white;
            transform: translateY(-3px);
        }

    .logout-btn {
        background: #082F5C;
    }

        .logout-btn:hover {
            background: #041F3D;
        }

    /* Card Header & Table */
    .dashboard-card .card-header {
        background: #0B4F8C;
        color: white;
        font-weight: 600;
        font-size: 22px;
        padding: 16px 24px; 
        border-bottom: none;
        border-radius: 0;
    }

    .table thead {
        background: #EAF3FF;
        color: #0B4F8C;
    }

    .table tbody tr:hover {
        background: #F3F9FF;
    }

    .badge {
        padding: 8px 14px;
        font-size: 13px;
    }
</style>
<div class="container mt-4">

    <!-- Welcome -->

    <div class="welcome-card">

        <div class="row align-items-center">

            <div class="col-md-8">

                <h2>Welcome, @Model.CustomerName 👋</h2>

                <p class="mb-0">
                    Manage your banking anytime, anywhere.
                </p>

            </div>

            <div class="col-md-4 text-end">

                <i class="bi bi-bank display-1"></i>

            </div>

        </div>

    </div>

    <!-- Account Summary -->

    <div class="row mb-4 g-4">

        <div class="col-md-4">

            <div class="dashboard-card p-4 text-center">

                <i class="bi bi-wallet2 icon"></i>

                <h6 class="mt-3 text-muted">Account Type</h6>

                <h4>@Model.AccountType</h4>

            </div>

        </div>

        <div class="col-md-4">

            <div class="dashboard-card p-4 text-center">

                <i class="bi bi-credit-card icon"></i>

                <h6 class="mt-3 text-muted">Account Number</h6>

                <h5>@Model.AccountNumber</h5>

            </div>

        </div>

        <div class="col-md-4">

            <div class="dashboard-card p-4 text-center">

                <i class="bi bi-cash-stack icon"></i>

                <h6 class="mt-3 text-muted">Available Balance</h6>

                <div class="balance">

                    ₹ @Model.Balance.ToString("N2")

                </div>

            </div>

        </div>

    </div>

    <!-- Quick Actions -->

    <div class="dashboard-card mb-4">

        <div class="card-header">

            Quick Banking Services

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">
                    <a asp-controller="Transaction" asp-action="Transfer" class="quick-btn">
                        <i class="bi bi-arrow-left-right me-2"></i> Transfer Money
                    </a>
                </div>

                <div class="col-md-4">
                    <a asp-controller="Bill" asp-action="PayBills" class="quick-btn">
                        <i class="bi bi-receipt me-2"></i> Pay Bills
                    </a>
                </div>

                <div class="col-md-4">
                <a asp-controller="ChequeBook"
                   asp-action="Request"
                   class="quick-btn">

                    <i class="bi bi-journal-bookmark me-2"></i>

                    Request Cheque Book

                </a>
                </div>

                <div class="col-md-4">
                    <a asp-controller="ChequeBook"
                       asp-action="Status"
                       class="quick-btn">

                        <i class="bi bi-journal-bookmark-fill me-2"></i>

                        Cheque Book Status

                    </a>
                </div>


                <div class="col-md-4">
                    <a asp-controller="Transaction" asp-action="History" class="quick-btn">
                        <i class="bi bi-file-earmark-text me-2"></i> Statement
                    </a>
                </div>

                @* <div class="col-md-12">
                    <a asp-controller="Profile" asp-action="Index" class="quick-btn">
                       <i class="bi bi-person-circle me-2"></i> My Profile
                    </a>
                </div> *@

                <div class="col-md-4">
                    <a asp-controller="Beneficiary" asp-action="Index" class="quick-btn">
                        <i class="bi bi-people me-2"></i> Beneficiaries
                    </a>
                </div>

                <div class="col-md-12">
                    <a asp-controller="Profile" asp-action="Index" class="quick-btn">
                        <i class="bi bi-box-arrow-right me-2"></i> My Profile
                    </a>
                </div>

            </div>

        </div>

    </div>

    <!-- Transactions -->

    <div class="dashboard-card">

        <div class="card-header">

            Recent Transactions

        </div>

        <div class="card-body">

            @if (Model.RecentTransactions.Any())
            {
                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>Date</th>

                            <th>Reference</th>

                            <th>Description</th>

                            <th>Type</th>

                            <th class="text-end">Amount</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.RecentTransactions)
                        {
                            <tr>

                                <td>

                                    @(item.TransactionDate?.ToString("dd MMM yyyy hh:mm tt"))

                                </td>

                                <td>

                                    @item.TransactionReference

                                </td>

                                <td>

                                    @item.Description

                                </td>

                                <td>

                                    @if (item.SenderAccountId == Model.AccountId)
                                    {
                                        <span class="badge bg-danger">
                                            Debit
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Credit
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    @if (item.SenderAccountId == Model.AccountId)
                                    {
                                        <span class="fw-bold text-danger">

                                            - ₹ @item.Amount.ToString("N2")

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-success">

                                            + ₹ @item.Amount.ToString("N2")

                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

                <div class="text-end">

                    <a asp-controller="Transaction"
                       asp-action="History"
                       class="btn btn-outline-primary">

                        View Complete Statement

                    </a>

                </div>
            }
            else
            {
                <div class="text-center p-5">

                    <i class="bi bi-clock-history display-4 text-primary"></i>

                    <h5 class="mt-3">

                        No Recent Transactions

                    </h5>

                    <p class="text-muted">

                        Your latest transactions will appear here.

                    </p>

                </div>
            }

        </div>

    </div>